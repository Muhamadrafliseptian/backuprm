# Salin ke .env lalu isi dengan nilai Anda sendiri
# cp .env.example .env

APP_NAME="Backup RM"
APP_ENV=development
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta

# ---------- Database ----------
DB_HOST=127.0.0.1
DB_PORT=8889          # 8889 = MAMP macOS, 3306 = server Linux
DB_NAME=db_backuprm
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# ---------- Session ----------
# Detik. 1800 = 30 menit
SESSION_LIFETIME=1800
SESSION_NAME=BACKUPRM_SESS

# ---------- Upload ----------
# Batas ukuran file .sql (bytes). 52428800 = 50 MB
UPLOAD_MAX_SIZE=52428800