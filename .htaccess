DirectoryIndex index.php

# ---------- Proteksi file sensitif ----------
<FilesMatch "^(\.env|\.env\..*|.*\.(sql|log|md|ini|sh|yml|yaml|bak|old)|composer\.(json|lock))$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. Blokir akses langsung ke folder sensitif & file .php internal
    RewriteCond %{REQUEST_URI} ^/(backups|uploads|logs|database|\.git|\.svn)/ [NC,OR]
    RewriteCond %{REQUEST_URI} ^/(pages|actions|core|config|bootstrap|layouts)/.*\.php$ [NC]
    RewriteRule ^ - [F,L]

    # 2. Pretty URL Routing standar
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.php [QSA,L]
</IfModule>