DirectoryIndex index.php

# ---------- Proteksi file sensitif ----------
<FilesMatch "^(\.env|\.env\..*|.*\.(sql|log|md|ini|sh|yml|yaml|bak|old)|composer\.(json|lock))$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. Blokir akses langsung ke folder internal & file PHP internal.
    #    Semua URL harus lewat router, bukan file fisik.
    #    Pakai %{THE_REQUEST} agar path relatif terhadap folder aplikasi,
    #    sehingga tetap benar walau nama folder berubah.
    RewriteCond %{THE_REQUEST} (?:^|\s)[^\s]*\?r= [NC]
    RewriteRule ^ - [L]
    RewriteCond %{THE_REQUEST} (?:^|\s)/rekam-medis/(?:backups|uploads|logs|database|\.git|\.svn)(?:/|\s|\?|$) [NC]
    RewriteRule ^ - [F,L]
    RewriteCond %{THE_REQUEST} (?:^|\s)/rekam-medis/(?:pages|actions|core|config|bootstrap|layouts)/.*\.php [NC]
    RewriteRule ^ - [F,L]

    # 2. Pretty URL Routing -> index.php
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.php [QSA,L]
</IfModule>