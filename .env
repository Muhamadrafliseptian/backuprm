# file   : .env
# fungsi : Konfigurasi environment MAMP macOS

APP_NAME="Backup RM"
APP_ENV=development
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta

DB_HOST=127.0.0.1
DB_PORT=8889
DB_NAME=db_backuprm
DB_USER=root
DB_PASS=root
DB_CHARSET=utf8mb4

# Session timeout: 30 menit (1800 detik)
SESSION_LIFETIME=1800
SESSION_NAME=BACKUPRM_SESS

UPLOAD_MAX_SIZE=52428800

# Mode development: lewati password saat login (JANGAN di produksi)
DEV_LOGIN=true
